{
  "uid": "llm-gateway",
  "title": "LLM Gateway",
  "tags": ["llm", "gateway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
        "query": "label_values(llm_gateway_requests_total, provider)",
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by outcome",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(llm_gateway_requests_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(llm_gateway_request_duration_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(llm_gateway_request_duration_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(llm_gateway_request_duration_seconds_bucket{provider=~\"$provider\"}[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache hit ratio (30m)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.1 },
              { "color": "green", "value": 0.3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_gateway_cache_lookups_total{result=\"hit\"}[30m])) / clamp_min(sum(rate(llm_gateway_cache_lookups_total{result=~\"hit|miss\"}[30m])), 0.001)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cache lookups by result",
      "gridPos": { "h": 6, "w": 9, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(llm_gateway_cache_lookups_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "heatmap",
      "title": "Best-candidate similarity distribution",
      "gridPos": { "h": 6, "w": 9, "x": 15, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (le) (rate(llm_gateway_cache_similarity_bucket[10m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Tokens per second",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(llm_gateway_tokens_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Spend per hour by owner",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (owner) (rate(llm_gateway_cost_usd_total[1h])) * 3600",
          "legendFormat": "{{owner}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "state-timeline",
      "title": "Circuit state by provider",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "closed", "color": "green" },
                "1": { "text": "half-open", "color": "orange" },
                "2": { "text": "open", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (llm_gateway_circuit_state)",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Provider errors and retries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, kind) (rate(llm_gateway_provider_errors_total[5m]))",
          "legendFormat": "{{provider}} {{kind}}"
        },
        {
          "refId": "B",
          "expr": "sum by (provider) (rate(llm_gateway_provider_retries_total[5m]))",
          "legendFormat": "{{provider}} retries"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Rate limit rejections and in-flight upstream calls",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "llm-gateway-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (owner) (rate(llm_gateway_rate_limit_rejections_total[5m]))",
          "legendFormat": "429 {{owner}}"
        },
        {
          "refId": "B",
          "expr": "sum by (provider) (llm_gateway_upstream_inflight)",
          "legendFormat": "in flight {{provider}}"
        }
      ]
    }
  ]
}
