# Copy to .env and adjust. Never commit the filled-in file.

# --- callers -----------------------------------------------------------------
# JSON object mapping an API key to its owner label and its private token bucket.
# The owner label is what appears in metrics; the key itself never does.
GATEWAY_API_KEYS={"sk-local-dev":{"owner":"dev","rate_per_second":5,"burst":20},"sk-local-ci":{"owner":"ci","rate_per_second":1,"burst":5}}

# --- backing services --------------------------------------------------------
GATEWAY_REDIS_URL=redis://localhost:6379/0
GATEWAY_ROUTING_CONFIG_PATH=config/routing.yaml

# --- providers ---------------------------------------------------------------
GATEWAY_OLLAMA_BASE_URL=http://localhost:11434
GATEWAY_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Leave empty to run local-only; routes that point at OpenRouter are then skipped.
GATEWAY_OPENROUTER_API_KEY=

# --- semantic cache ----------------------------------------------------------
GATEWAY_CACHE_ENABLED=true
GATEWAY_CACHE_TTL_SECONDS=3600
GATEWAY_CACHE_SIMILARITY_THRESHOLD=0.94
GATEWAY_CACHE_MAX_CANDIDATES=64
GATEWAY_CACHE_INDEX_SIZE=2000
GATEWAY_CACHE_MAX_TEMPERATURE=0.2
GATEWAY_EMBEDDING_BASE_URL=http://localhost:11434
GATEWAY_EMBEDDING_MODEL=nomic-embed-text
GATEWAY_EMBEDDING_TIMEOUT_SECONDS=5

# --- resilience --------------------------------------------------------------
GATEWAY_REQUEST_TIMEOUT_SECONDS=60
GATEWAY_CONNECT_TIMEOUT_SECONDS=5
GATEWAY_RETRY_MAX_ATTEMPTS=3
GATEWAY_RETRY_BASE_DELAY_SECONDS=0.2
GATEWAY_RETRY_MAX_DELAY_SECONDS=5
GATEWAY_RETRY_JITTER=1.0
GATEWAY_BREAKER_FAILURE_THRESHOLD=5
GATEWAY_BREAKER_SUCCESS_THRESHOLD=2
GATEWAY_BREAKER_RECOVERY_SECONDS=30
GATEWAY_BREAKER_HALF_OPEN_MAX_CALLS=2

# --- limits and accounting ---------------------------------------------------
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_USAGE_RETENTION_DAYS=90

# --- observability -----------------------------------------------------------
GATEWAY_LOG_LEVEL=INFO
GATEWAY_OTEL_ENABLED=false
GATEWAY_OTEL_ENDPOINT=http://localhost:4317
